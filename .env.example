# Copy this file to .env and fill in your own values. The .env file is gitignored,
# so your token never ends up in the repository.

GUARD_URL=https://secureai-guard-598609297408.europe-west4.run.app
GUARD_TOKEN=sai_your_team_token_here
LLM_API_KEY=sk-proj-your_key_here

# Only change these if the organizers point you at a different host or model.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# When to translate messages to English before the Guard checks them: always, auto or off.
TRANSLATE_MODE=always
